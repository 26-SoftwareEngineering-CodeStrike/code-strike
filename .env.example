# Server
APP_ENV=development
APP_NAME=CodeStrike API
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Reserved for Phase 2. Phase 1 never connects to MySQL.
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/codestrike

# Frontend build-time API base. Mock mode is enabled by default in Phase 1.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_USE_MOCK=true

