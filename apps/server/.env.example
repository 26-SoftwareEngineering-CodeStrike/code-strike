# Copy to .env locally. Set secrets; never commit .env.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=codestrike
MYSQL_USER=codestrike
MYSQL_PASSWORD=
MYSQL_PORT=3307
# URL-encode special characters in credentials. Backend reads process environment.
DATABASE_URL=mysql+pymysql://codestrike:REPLACE_ME@127.0.0.1:3307/codestrike?charset=utf8mb4
ENABLE_DOCS=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TOKEN_TTL_SECONDS=86400
# Provisional configurable policy; not approved SRS constants.
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_COOLDOWN_SECONDS=60
AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_SECONDS=900
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# No university timetable has been approved. Leave unset until confirmed.
SEMESTER_START_DATE=
PERIOD_TIMES={}
